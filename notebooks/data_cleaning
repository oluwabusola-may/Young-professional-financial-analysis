   "source": [
    "import numpy as np\n",
    "\n",
    "COL_BUDGETING = 'budget_spending'        \n",
    "COL_SAVING_FREQ = 'monthly_savings'        \n",
    "COL_SAVING_PCT = 'pct_saved'               \n",
    "COL_EMERGENCY_FUND = 'emergency_fund'       \n",
    "COL_EMERGENCY_MONTHS = 'emergency_months'   \n",
    "COL_INVESTS = 'investment'                  \n",
    "COL_LITERACY_CONFIDENCE = 'Confidence in budgeting'  \n",
    "COL_LITERACY_KNOWLEDGE = 'inflation_compound_int'    \n",
    "# ==========================================================\n",
    "\n",
    "def score_budgeting(answer):\n",
    "    mapping = {'Yes, consistently': 20, 'Sometimes': 10, 'No': 0}\n",
    "    return mapping.get(answer, 0)\n",
    "\n",
    "def score_saving(freq_answer, pct_answer):\n",
    "    base_map = {'0%': 0, '1-10%': 10, '11-20%': 18, '21%+': 25}\n",
    "    multiplier_map = {'Always': 1.0, 'Sometimes': 0.75, 'Rarely': 0.5, 'Never': 0}\n",
    "    base = base_map.get(pct_answer, 0)\n",
    "    multiplier = multiplier_map.get(freq_answer, 0)\n",
    "    return round(base * multiplier)\n",
    "\n",
    "def score_emergency_fund(has_fund, months_answer):\n",
    "    if has_fund != 'Yes':\n",
    "        return 0\n",
    "    mapping = {'6+': 20, '3-6': 15, '1-3': 10, '<1': 5}\n",
    "    return mapping.get(months_answer, 0)\n",
    "\n",
    "def score_investing(answer):\n",
    "    return 20 if answer == 'Yes' else 0\n",
    "\n",
    "def score_literacy(confidence_answer, knowledge_answer):\n",
    "    confidence_map = {'1': 0, '2': 2, '3': 4, '4': 6, '5': 8}\n",
    "    knowledge_map = {'Yes, both': 7, 'One of them': 4, 'Neither': 0}\n",
    "    confidence_pts = confidence_map.get(str(confidence_answer).strip(), 0)\n",
    "    knowledge_pts = knowledge_map.get(knowledge_answer, 0)\n",
    "    return confidence_pts + knowledge_pts\n",
    "\n",
    "def get_category(total):\n",
    "    if total >= 80:\n",
    "        return 'Thriving'\n",
    "    elif total >= 60:\n",
    "        return 'Stable'\n",
    "    elif total >= 40:\n",
    "        return 'At Risk'\n",
    "    else:\n",
    "        return 'Vulnerable'\n",
    "\n",
    "TIE_BREAK_ORDER = ['Emergency Fund', 'Saving', 'Budgeting', 'Investing', 'Financial Literacy']\n",
    "\n",
    "def get_lowest_area(row_scores):\n",
    "    max_by_area = {'Budgeting': 20, 'Saving': 25, 'Emergency Fund': 20, 'Investing': 20, 'Financial Literacy': 15}\n",
    "    pcts = {area: row_scores[area] / max_by_area[area] for area in row_scores}\n",
    "    lowest_pct = min(pcts.values())\n",
    "    candidates = [area for area, pct in pcts.items() if pct == lowest_pct]\n",
    "    if len(candidates) == 1:\n",
    "        return candidates[0]\n",
    "    for area in TIE_BREAK_ORDER:\n",
    "        if area in candidates:\n",
    "            return area\n",
    "    return candidates[0]\n",
    "\n",
    "def calculate_wellness_score(row):\n",
    "    scores = {\n",
    "        'Budgeting': score_budgeting(row[COL_BUDGETING]),\n",
    "        'Saving': score_saving(row[COL_SAVING_FREQ], row[COL_SAVING_PCT]),\n",
    "        'Emergency Fund': score_emergency_fund(row[COL_EMERGENCY_FUND], row[COL_EMERGENCY_MONTHS]),\n",
    "        'Investing': score_investing(row[COL_INVESTS]),\n",
    "        'Financial Literacy': score_literacy(row[COL_LITERACY_CONFIDENCE], row[COL_LITERACY_KNOWLEDGE]),\n",
    "    }\n",
    "    total = sum(scores.values())\n",
    "    category = get_category(total)\n",
    "    lowest_area = get_lowest_area(scores)\n",
    "    return pd.Series({'wellness_score': total, 'category': category, 'lowest_area': lowest_area})\n",
    "df[['wellness_score', 'category', 'lowest_area']] = df.apply(calculate_wellness_score, axis=1)"
   ]
